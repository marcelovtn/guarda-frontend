# ---------------------------------------------------------------------------
# GUARDA — frontend
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Base URL of the backend (blank-backend / guarda-backend).
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Public URL of this frontend. Used to build the password-reset and
# email-confirmation links sent to the user (src/app/auth/auth.slice.ts).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Caminhos de auth desligados ------------------------------------------
# Ver src/lib/auth/features.ts. Ficam escondidos da tela enquanto não houver
# infra por trás; ligar é preencher com "true" (e configurar o backend).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH="false"
NEXT_PUBLIC_ENABLE_PASSWORD_RESET="false"

# Slug do professor para quem o fluxo de assinatura aponta quando a URL não diz
# (src/lib/instructor/defaultInstructor.ts). Vazio é válido: as telas de plano e
# de checkout mostram "nenhum professor disponível" em vez de carregar para sempre.
NEXT_PUBLIC_DEFAULT_INSTRUCTOR=""
