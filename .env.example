# ---------------------------------------------------------------------------
# GUARDA — frontend
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Base URL of the backend (blank-backend / guarda-backend).
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Public URL of this frontend. Used to build the password-reset and
# email-confirmation links sent to the user (src/app/auth/auth.slice.ts).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Master key for the client-side encryption helpers in
# src/utils/keyEncryptionUtils.ts. Leave empty if the feature is unused.
NEXT_PUBLIC_MASTER_ENCRYPTION_KEY=""
